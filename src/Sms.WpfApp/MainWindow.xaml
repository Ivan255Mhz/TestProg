<Window x:Class="Sms.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Тестовое WPF-приложение для SmartMealService"
        Height="420" Width="760"
        MinHeight="300" MinWidth="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">


    <Border Margin="16"
            CornerRadius="14"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                               Opacity="0.25"
                               BlurRadius="28"
                               ShadowDepth="4"
                               Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Тестовое WPF-приложение для SmartMealService"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#222222"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <Button x:Name="MinimizeButton"
                            Content="&#8212;"
                            Width="32" Height="28"
                            FontSize="13"
                            Foreground="#222222"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="&#10005;"
                            Width="32" Height="28"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#222222"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      x:Name="EnvVarsGrid"
                      Margin="16,0,16,16"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="All"
                      GridLinesVisibility="All"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Поле"
                                         Binding="{Binding Field}"
                                         IsReadOnly="True"
                                         Width="*"/>
                    <DataGridTextColumn Header="Значение"
                                         Binding="{Binding Value}"
                                         IsReadOnly="False"
                                         Width="*"/>
                    <DataGridTextColumn Header="Комментарий"
                                         Binding="{Binding Comment}"
                                         IsReadOnly="True"
                                         Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
